{
  "name": "studynook",
  "productName": "StudyNook",
  "version": "1.5.3",
  "description": "Study focus app with app and website blocking, Pomodoro timer, tasks, notes, stats and a study pet.",
  "main": "app/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js",
    "smoke": "node tests/smoke.js",
    "lint": "eslint .",
    "dist": "electron-builder --win --x64"
  },
  "author": "StudyNook",
  "license": "SEE LICENSE IN ../LICENSE",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "app.studynook.desktop",
    "productName": "StudyNook",
    "afterPack": "build/afterPack.js",
    "artifactName": "StudyNook-Setup-${version}.exe",
    "files": [
      "app/**/*",
      "extension/rules.js",
      "assets/icon.ico",
      "assets/icon-256.png",
      "assets/icon-32.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "StudyNook",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "license": null,
      "include": "build/installer.nsh"
    }
  }
}
